{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cursor-fm",
	// Set this to today's date
	"compatibility_date": "2026-08-19",
	"main": "./src/worker.ts",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/merged-audio.mp3"
		],
	},
	"observability": {
		"enabled": true,
	},
	"vars": {
		// Public URL of the mix. Local .dev.vars overrides this.
		"AUDIO_PUBLIC_URL": "/merged-audio.mp3?v=2",
		// Must match the real file length (ffprobe).
		"DURATION_SECONDS": "1236",
	},
	"r2_buckets": [
		{
			"binding": "AUDIO",
			"bucket_name": "cursorfm-audio",
		},
	],
}